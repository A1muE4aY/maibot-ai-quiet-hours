{
  "manifest_version": 2,
  "id": "a1mue4ay.ai-quiet-hours",
  "version": "1.1.0",
  "name": "AI 时段静默守卫",
  "plugin_type": "automation",
  "description": "在指定时段支持切换至 MaiBot 已注册的回退模型继续服务（若未配置或无可用回退模型，则执行静默拦截规则），支持中国法定节假日与调休补班识别、同插件/群聊/用户列表可视化选择及时段通知。",
  "author": {
    "name": "A1muE4aY",
    "url": "https://github.com/A1muE4aY"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/A1muE4aY/maibot-ai-quiet-hours",
    "homepage": "https://github.com/A1muE4aY/maibot-ai-quiet-hours",
    "documentation": "https://github.com/A1muE4aY/maibot-ai-quiet-hours/tree/main/docs",
    "issues": "https://github.com/A1muE4aY/maibot-ai-quiet-hours/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.4.0",
    "max_version": "1.9.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.50.99"
  },
  "dependencies": [],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "moon",
      "background": "#1E293B"
    }
  },
  "capabilities": [
    "send.text",
    "chat.get_all_streams",
    "chat.get_group_streams",
    "chat.get_private_streams",
    "database.query",
    "component.get_all_plugins",
    "component.enable",
    "component.disable",
    "config.get",
    "runtime.set_status_badges"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
