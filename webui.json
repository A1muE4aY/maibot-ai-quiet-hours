{
  "schema_version": 2,
  "required_capabilities": [
    "declarative_basic"
  ],
  "workspace_title": "AI 时段静默守卫",
  "pages": [
    {
      "id": "dashboard",
      "mode": "declarative",
      "title": "AI 时段静默控制台",
      "description": "实时查看 AI 聊天静默状态、节假日识别结果、大模型插件审计清单，并支持手动切换与一键重扫。",
      "icon": "chart",
      "auto_refresh": true,
      "poll_interval_seconds": 10,
      "queries": {
        "status": {
          "api": "webui_status",
          "version": "1"
        }
      },
      "actions": {
        "force_quiet": {
          "api": "webui_force_quiet",
          "version": "1",
          "parameters": {
            "duration_minutes": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 1440
            },
            "reason": {
              "type": "string",
              "required": false,
              "max_length": 120
            }
          }
        },
        "force_active": {
          "api": "webui_force_active",
          "version": "1",
          "parameters": {
            "duration_minutes": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 1440
            }
          }
        },
        "restore_auto": {
          "api": "webui_restore_auto",
          "version": "1"
        },
        "rescan_plugins": {
          "api": "webui_rescan_plugins",
          "version": "1"
        },
        "sync_holidays": {
          "api": "webui_sync_holidays",
          "version": "1"
        }
      },
      "content": [
        {
          "type": "grid",
          "columns": 4,
          "children": [
            {
              "type": "stat",
              "label": "当前 AI 状态",
              "value": {
                "source": "status",
                "field": "state_label"
              }
            },
            {
              "type": "stat",
              "label": "今日日期类型",
              "value": {
                "source": "status",
                "field": "today_summary"
              }
            },
            {
              "type": "stat",
              "label": "下次状态切换",
              "value": {
                "source": "status",
                "field": "next_transition_label"
              }
            },
            {
              "type": "stat",
              "label": "识别到的大模型插件",
              "value": {
                "source": "status",
                "field": "blocked_plugin_count"
              }
            }
          ]
        },
        {
          "type": "card",
          "label": "快速控制与手动覆盖",
          "children": [
            {
              "type": "text",
              "label": "当前状态说明",
              "value": {
                "source": "status",
                "field": "status_detail"
              }
            },
            {
              "type": "grid",
              "columns": 2,
              "children": [
                {
                  "type": "input",
                  "name": "duration_minutes",
                  "label": "临时生效时长（分钟，0 表示持续至手动取消）",
                  "value": 60
                },
                {
                  "type": "input",
                  "name": "reason",
                  "label": "手动静默说明（可选）",
                  "value": "管理员临时开启"
                }
              ]
            },
            {
              "type": "grid",
              "columns": 3,
              "children": [
                {
                  "type": "button",
                  "label": "立即开启 AI 静默",
                  "action": "force_quiet",
                  "variant": "primary"
                },
                {
                  "type": "button",
                  "label": "立即恢复 AI 运行",
                  "action": "force_active",
                  "variant": "muted"
                },
                {
                  "type": "button",
                  "label": "恢复自动时段调度",
                  "action": "restore_auto",
                  "variant": "muted"
                }
              ]
            },
            {
              "type": "grid",
              "columns": 2,
              "children": [
                {
                  "type": "button",
                  "label": "重新扫描大模型插件",
                  "action": "rescan_plugins",
                  "variant": "muted"
                },
                {
                  "type": "button",
                  "label": "立即同步年度节假日",
                  "action": "sync_holidays",
                  "variant": "muted"
                }
              ]
            }
          ]
        },
        {
          "type": "tabs",
          "children": [
            {
              "type": "stack",
              "label": "大模型插件审计",
              "children": [
                {
                  "type": "text",
                  "label": "最近扫描时间",
                  "value": {
                    "source": "status",
                    "field": "last_scan_at"
                  }
                },
                {
                  "type": "table",
                  "label": "已加载与已安装插件的大模型依赖检查结果",
                  "value": {
                    "source": "status",
                    "field": "audited_plugins"
                  },
                  "columns": [
                    {
                      "field": "plugin_id",
                      "label": "插件 ID"
                    },
                    {
                      "field": "display_name",
                      "label": "插件名称"
                    },
                    {
                      "field": "decision",
                      "label": "静默期策略"
                    },
                    {
                      "field": "commands",
                      "label": "已注册命令"
                    },
                    {
                      "field": "reasons",
                      "label": "检测依据"
                    }
                  ]
                }
              ]
            },
            {
              "type": "stack",
              "label": "静默时段规则",
              "children": [
                {
                  "type": "table",
                  "label": "当前已配置的静默规则",
                  "value": {
                    "source": "status",
                    "field": "rules"
                  },
                  "columns": [
                    {
                      "field": "name",
                      "label": "规则名"
                    },
                    {
                      "field": "enabled_label",
                      "label": "状态"
                    },
                    {
                      "field": "time_range",
                      "label": "时间段"
                    },
                    {
                      "field": "day_scope",
                      "label": "日期范围"
                    },
                    {
                      "field": "active_now",
                      "label": "当前是否命中"
                    }
                  ]
                }
              ]
            },
            {
              "type": "stack",
              "label": "近期节假日与调休",
              "children": [
                {
                  "type": "text",
                  "label": "日历数据来源",
                  "value": {
                    "source": "status",
                    "field": "holiday_source_summary"
                  }
                },
                {
                  "type": "table",
                  "label": "未来 90 天法定节假日与调休补班",
                  "value": {
                    "source": "status",
                    "field": "upcoming_holidays"
                  },
                  "columns": [
                    {
                      "field": "date",
                      "label": "日期"
                    },
                    {
                      "field": "day_type_label",
                      "label": "类型"
                    },
                    {
                      "field": "holiday_name",
                      "label": "说明"
                    },
                    {
                      "field": "source",
                      "label": "来源"
                    }
                  ]
                }
              ]
            },
            {
              "type": "stack",
              "label": "状态切换与拦截记录",
              "children": [
                {
                  "type": "table",
                  "label": "最近 30 条运行事件",
                  "value": {
                    "source": "status",
                    "field": "recent_events"
                  },
                  "columns": [
                    {
                      "field": "time",
                      "label": "时间"
                    },
                    {
                      "field": "event_type",
                      "label": "类型"
                    },
                    {
                      "field": "target",
                      "label": "对象"
                    },
                    {
                      "field": "detail",
                      "label": "详情"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
