{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages",
    "structured_arguments"
  ],
  "workspace_title": "AI 时段静默守卫",
  "pages": [
    {
      "id": "dashboard",
      "title": "AI 时段静默守卫",
      "description": "配置时段回退模型切换、静默拦截、同插件屏蔽规则、豁免群聊与豁免用户",
      "icon": "settings",
      "mode": "custom",
      "entry": "webui/console.html",
      "layout": "document",
      "queries": {
        "bootstrap": {
          "api": "webui_console_bootstrap",
          "version": "1"
        },
        "status": {
          "api": "webui_status",
          "version": "1"
        }
      },
      "actions": {
        "force_quiet": {
          "api": "webui_force_quiet",
          "version": "1",
          "parameters": {
            "duration_minutes": {
              "type": "integer",
              "required": true,
              "minimum": 0,
              "maximum": 1440
            },
            "reason": {
              "type": "string",
              "max_length": 120
            }
          }
        },
        "force_fallback": {
          "api": "webui_force_fallback",
          "version": "1",
          "parameters": {
            "duration_minutes": {
              "type": "integer",
              "required": true,
              "minimum": 0,
              "maximum": 1440
            },
            "fallback_models": {
              "type": "array",
              "items": {
                "type": "string",
                "max_length": 200
              }
            }
          }
        },
        "force_active": {
          "api": "webui_force_active",
          "version": "1",
          "parameters": {
            "duration_minutes": {
              "type": "integer",
              "required": true,
              "minimum": 0,
              "maximum": 1440
            }
          }
        },
        "restore_auto": {
          "api": "webui_restore_auto",
          "version": "1"
        },
        "rescan_plugins": {
          "api": "webui_rescan_plugins",
          "version": "1"
        },
        "rescan_models": {
          "api": "webui_rescan_models",
          "version": "1"
        },
        "sync_holidays": {
          "api": "webui_sync_holidays",
          "version": "1"
        },
        "save_model_fallback": {
          "api": "webui_save_model_fallback",
          "version": "1",
          "parameters": {
            "enabled": {
              "type": "boolean",
              "required": true
            },
            "fallback_models": {
              "type": "array",
              "required": true,
              "items": {
                "type": "string",
                "max_length": 200
              }
            },
            "target_tasks": {
              "type": "array",
              "required": true,
              "items": {
                "type": "string",
                "max_length": 64
              }
            },
            "switch_mode": {
              "type": "string",
              "required": true,
              "choices": [
                "replace",
                "prepend"
              ]
            },
            "fallback_to_quiet_if_unavailable": {
              "type": "boolean",
              "required": true
            }
          }
        },
        "save_plugin_guard": {
          "api": "webui_save_plugin_guard",
          "version": "1",
          "parameters": {
            "enabled": {
              "type": "boolean",
              "required": true
            },
            "block_mode": {
              "type": "string",
              "required": true,
              "choices": [
                "smart",
                "hook_only",
                "disable_components"
              ]
            },
            "force_block_plugins": {
              "type": "array",
              "required": true,
              "items": {
                "type": "string",
                "max_length": 200
              }
            },
            "force_allow_plugins": {
              "type": "array",
              "required": true,
              "items": {
                "type": "string",
                "max_length": 200
              }
            },
            "force_allow_commands": {
              "type": "array",
              "required": true,
              "items": {
                "type": "string",
                "max_length": 200
              }
            }
          }
        },
        "save_exemptions": {
          "api": "webui_save_exemptions",
          "version": "1",
          "parameters": {
            "exempt_groups": {
              "type": "array",
              "required": true,
              "items": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string",
                    "max_length": 100
                  },
                  "type": {
                    "type": "string",
                    "choices": [
                      "group"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "required": true,
                    "max_length": 200
                  },
                  "name": {
                    "type": "string",
                    "max_length": 200
                  }
                }
              }
            },
            "exempt_users": {
              "type": "array",
              "required": true,
              "items": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string",
                    "max_length": 100
                  },
                  "type": {
                    "type": "string",
                    "choices": [
                      "user"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "required": true,
                    "max_length": 200
                  },
                  "name": {
                    "type": "string",
                    "max_length": 200
                  }
                }
              }
            },
            "user_exempt_in_group": {
              "type": "boolean",
              "required": true
            },
            "exempt_platforms": {
              "type": "array",
              "required": true,
              "items": {
                "type": "string",
                "max_length": 100
              }
            }
          }
        }
      }
    }
  ]
}
